# AWS region where detector infrastructure is deployed.
aws_region = "us-east-1"

# AWS regions whose supported resources should be scanned.
#
# If omitted, the detector scans only aws_region.
scan_regions = [
  "us-east-1",
]

# Environment tag applied to deployed resources.
environment = "prod"

# Base project name used by the detector.
project_name = "aws-cost-waste-detector"

# DynamoDB table used to persist findings.
findings_table_name = "WasteFindings"

# How often the detector automatically scans the account.
scan_schedule = "rate(1 day)"

# Number of days a continuously detected finding remains OBSERVED
# before transitioning to OPEN.
finding_grace_period_days = 7

# Optional email address for HIGH/CRITICAL findings, report summaries,
# and detector health alarms.
#
# SNS will send a confirmation email after deployment.
alert_email = "you@example.com"

# Maximum Lambda execution time in seconds.
#
# Higher values provide additional headroom for multi-region scans and
# utilization-based detectors such as Idle EC2.
lambda_timeout_seconds = 180

# Idle EC2 detection settings.
#
# Only running On-Demand instances that have existed for the complete
# lookback window are evaluated.

# Number of days of CloudWatch metrics used for idle evaluation.
ec2_idle_lookback_days = 7

# Maximum average CPU utilization percentage for an instance to be
# considered idle.
ec2_idle_average_cpu_threshold_percent = 5

# Maximum observed CPU utilization percentage for an instance to be
# considered idle.
ec2_idle_maximum_cpu_threshold_percent = 20

# Maximum inbound network traffic over the lookback window.
ec2_idle_network_in_threshold_mib = 100

# Maximum outbound network traffic over the lookback window.
ec2_idle_network_out_threshold_mib = 100

# Minimum fraction of expected CloudWatch datapoints required before
# an instance can be classified as idle.
ec2_idle_minimum_metric_coverage = 0.80

# Existing/default resource names.
#
# These can be changed when deploying into an account that already
# contains resources with the same names.
lambda_role_name = "cost-waste-detector-lambda-role"

scheduler_name = "aws-cost-waste-detector-daily"

scheduler_role_name = "cost-waste-detector-scheduler-role"

alerts_topic_name = "aws-cost-waste-detector-alerts"

# Generated HTML reports are automatically removed after this many days.
report_retention_days = 30

# Protect finding history with DynamoDB point-in-time recovery.
dynamodb_point_in_time_recovery_enabled = true

# Leave false by default so `terraform destroy` can cleanly uninstall
# the detector. Customers can enable this for stronger protection.
dynamodb_deletion_protection_enabled = false